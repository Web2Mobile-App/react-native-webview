{
  "manifest_version": 2,
  "name": "web2mobile_document_end",
  "version": "1.0.0",
  "description": "",
  "browser_specific_settings": {
    "gecko": {
      "id": "{22222222-2222-2222-2222-222222222222}"
    }
  },
  "content_scripts": [
    {
      "all_frames": true,
      "matches": [
        "<all_urls>"
      ],
      "run_at": "document_end",
      "js": [
        "index.js"
      ]
    }
  ],
  "permissions": [
    "nativeMessaging",
    "geckoViewAddons",
    "nativeMessagingFromContent"
  ]
}